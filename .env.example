# InsightIQ Environment Configuration

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=insightiq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Read-only user for SQL tool execution safety
POSTGRES_READONLY_USER=insightiq_readonly
POSTGRES_READONLY_PASSWORD=readonly_secret

# Ollama & LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text

# ChromaDB Vector Store
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Query Execution Safety Limits
SQL_QUERY_TIMEOUT_SECONDS=10
SQL_MAX_ROWS_RETURNED=500
